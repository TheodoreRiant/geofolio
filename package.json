{
  "name": "geofolio",
  "private": true,
  "description": "Development tooling for the Geofolio WordPress plugin (the plugin itself needs no build to run).",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run build:block",
    "build:css": "node tools/build-css.js",
    "build:js": "node tools/build-js.js",
    "test": "node --test tests/js/*.test.js",
    "lint:js": "eslint assets/js tests/js tools eslint.config.js",
    "lint:css": "stylelint \"assets/css/src/*.css\" assets/css/geofolio-admin.css",
    "lint": "npm run lint:js && npm run lint:css",
    "build:block": "wp-scripts build --webpack-src-dir=blocks/map/src --output-path=blocks/map/build --webpack-copy-php"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.27.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-recommended": "^14.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
