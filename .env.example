# Copy to .env (never committed) for the local Docker environment.

# Tile provider key for "key required" basemaps (CARTO Positron…), free:
# https://carto.com/basemaps/apikey — without it, the map falls back to Positron via OpenFreeMap.
MAPPED_PLACES_TILE_API_KEY=

# Local port (default: 8080)
# MAPPED_PLACES_PORT=8080
